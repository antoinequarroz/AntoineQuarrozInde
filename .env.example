# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email de réception des messages du formulaire de contact
CONTACT_EMAIL=info@antoinequarroz.ch
MONITORING_ALERT_EMAIL=info@antoinequarroz.ch

# Optional operations thresholds
MAX_BACKUP_AGE_HOURS=36
MAX_DISK_USAGE_PERCENT=85
MONITOR_TLS_WARN_DAYS=21

# Independent encrypted backup (optional but recommended). Configure the
# rclone remote on the VPS first; example: aq-r2:antoinequarroz-backups/prod
OFFSITE_RCLONE_REMOTE=
OFFSITE_AGE_RECIPIENT=
OFFSITE_AGE_IDENTITY_FILE=
OFFSITE_KEEP_DAYS=30
REQUIRE_OFFSITE_BACKUP=false
REQUIRE_RESTORE_DRILL=false
RECURRING_AUTOMATION_SECRET=

# Public Cal.com booking page, for example https://cal.com/your-name/30min
NUXT_PUBLIC_CAL_LINK=
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=antoinequarroz.ch
NUXT_PUBLIC_PLAUSIBLE_ENDPOINT=https://plausible.io/api/event
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Paiement TWINT via Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NUXT_PUBLIC_SITE_URL=https://www.antoinequarroz.ch

# Cloudflare Turnstile (anti-bot)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: restrict admin API access to a single Supabase user email
ADMIN_EMAIL=

# Public/default tenant slug for non-authenticated content reads
DEFAULT_ORGANIZATION_SLUG=

# Playwright E2E (store real values in the ignored .env.e2e file)
E2E_BASE_URL=http://127.0.0.1:3100
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
